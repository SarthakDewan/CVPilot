# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB (local container in dev, Atlas SRV string in production)
MONGODB_URI=mongodb://localhost:27017/cvpilot

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Short-lived access token (jsonwebtoken format: 15m, 1h, ...)
JWT_EXPIRES_IN=30m

# bcrypt cost factor (must be >= 12)
BCRYPT_COST=12

# Strict CORS: exact origin(s) of the web app, comma separated
CORS_ORIGINS=http://localhost:5173

# Cookie settings. COOKIE_SECURE is forced on when NODE_ENV=production.
COOKIE_SAMESITE=lax

# Internal ML service (used from Phase 3 onward)
ML_SERVICE_URL=http://localhost:8000
ML_SHARED_SECRET=change-me-shared-secret-with-ml-service
