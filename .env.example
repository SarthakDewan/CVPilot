# Used by docker-compose. Copy to .env (never commit it).
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ML_SHARED_SECRET=

# Origin(s) of the web app, comma separated (must match what the browser shows in its address bar).
CORS_ORIGINS=http://localhost:8080

# Optional: use MongoDB Atlas instead of the bundled container, e.g. mongodb+srv://user:pass@cluster/cvpilot
# MONGODB_URI=

# NODE_ENV=production enables secure cookies, which require HTTPS.
# For plain-http local testing keep this as development.
NODE_ENV=development

# Needed from later phases (ML service only)
GEMINI_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
