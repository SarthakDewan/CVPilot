# Copy to .env. Never commit .env.
# Must match ML_SHARED_SECRET in gateway/.env
ML_SHARED_SECRET=change-me-shared-secret-with-ml-service

# Gemini (text generation). Optional: without it, explanations/tips fall back to deterministic templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Adzuna (job listings). Required for job search, market insights and the roadmap.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Optional: point at a proxy/mock instead of https://api.adzuna.com/v1/api/jobs
# ADZUNA_BASE_URL=

# Sentence-transformers model used for the ATS score and job matching
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Scam detection. theta1/theta2/w_r default to 0.25/0.5/0.5, or to the values tuned by
# eval/train_scam_classifier.py (models/scam_settings.json) when a trained model is present. Env vars win.
# SCAM_THETA1=0.25
# SCAM_THETA2=0.5
# SCAM_W_R=0.5
# SCAM_RULE_FLOOR=1                 # 0 = use the plain formula r = w_r*rho + w_c*P_clf
# SCAM_RULES_PATH=                  # custom rules JSON (same format as app/data/scam_rules.json)
# SCAM_MODEL_PATH=                  # default: ml-service/models/scam_clf.joblib
# SKILLS_LEXICON_PATH=              # custom skills lexicon JSON
